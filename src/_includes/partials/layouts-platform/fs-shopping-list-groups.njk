{% from "partials/fs-components/fs-formatPrice.njk" import formatPrice %}

{% for storefrontKey, storefront in shoppingListStorefronts %}
  <div class="fs-tasksList__group">
    <header class="fs-tasksList__header">
      <h3 class="fs-tasksList__heading">From the {{ storefront.storefrontName }}</h3>
    </header>

    <ul class="fs-tasksList__body">
      {% for item in storefront.shoppingList %}
        {% set isCurrentTask = shoppingListCurrentRoute and item.studyRoute == shoppingListCurrentRoute %}
        {% set isLinkedTask = isCurrentTask or not item.completed %}
        <li class="fs-tasksList__item">
          {% if isLinkedTask %}
            <a href="{{ shoppingListCurrentUrl if isCurrentTask else (resolvePageUrl(item.studyRoute, 'index') if item.studyRoute else item.url) }}"
               class="fs-tasksList__button{% if item.completed %} is-completed{% elif item.accepted %} is-accepted{% endif %}{% if item.incentive %} is-incentivised{% endif %}"{% if isCurrentTask %} aria-current="page"{% endif %}>
          {% else %}
            <div class="fs-tasksList__button is-completed {% if item.incentive %} is-incentivised{% endif %}">
          {% endif %}

            <span class="fs-tasksList__marker icon" aria-hidden="true">
              {% if item.completed %}
                <svg class="" viewBox="0 0 24 24" focusable="false">
                  <use href="#check"></use>
                </svg>
              {% endif %}
              {% if item.accepted and not item.completed %}
                <svg class="" viewBox="0 0 24 24" focusable="false">
                  <use href="#clock"></use>
                </svg>
              {% endif %}
              {% if item.incentive and not item.completed %}
                <svg class="" viewBox="0 0 24 24" focusable="false">
                  <use href="#dollar-sign"></use>
                </svg>
              {% endif %}
            </span>

            <div class="fs-tasksList__identifier">
              <div class="identifier__label">
                {{ item.label }}
              </div>

              {% if item.incentive and not item.completed %}
                  <div class="identifier__status">Incentive available</div>
              {% endif %}

              {% if item.accepted and not item.completed %}
                  <div class="identifier__status">Accepted but not completed</div>
              {% endif %}

              {% if item.incentive and item.completed %}
                  <div class="identifier__status">Incentive task done</div>
              {% endif %}

              {% if not item.incentive and item.completed %}
                  <div class="identifier__status">Task done</div>
              {% endif %}

              {% if isCurrentTask %}
                <div class="identifier__status" aria-hidden="true">You’re here</div>
                {% for detail in shoppingListCurrentTask.instructionDetail %}
                  <p>{{ detail | safe }}</p>
                {% endfor %}
              {% endif %}
            </div>

            {% if item.incentive and item.amount %}
              <div class="fs-tasksList__incentive">
                {{ formatPrice(item.amount, currency="AUD", locale="en-AU") }}
              </div>
            {% endif %}

          {% if isLinkedTask %}
            </a>
          {% else %}
            </div>
          {% endif %}

        </li>
      {% endfor %}
    </ul>
  </div>
{% endfor %}
