{% set pageName = "shoppers" %}
{% set componentName = "profile_settings" %}
{% set logoDescription = "Fake Supermarket shopper dashboard" %}

<header id="header-{{ pageName }}" class="fs-header">
  <div class="container">
    <nav id="header-navigation" class="fs-nav-main">
      <a title="{{ logoDescription }}" href="{{ page.url | escape }}" id="site-logo">
        <svg class="fs-logo-symbol" viewBox="0 0 228 228" aria-hidden="true">
          <use href="#fs-logo"></use>
        </svg>        
      </a> 

      {# <div id="header-main-actions" aria-hidden="true"></div>
      <div id="header-cart" aria-hidden="true"></div> #}

      <div id="header-{{ pageName }}-auth">
        <div class="header-compact">
          <div class="fs-nav-btnGroup">
            <div class="fs-btn-group">          
              <button commandfor="auth-{{ componentName }}-overlay" command="show-modal" aria-label="Open the shoppers menu" class="fs-btn btn-tertiary btn-icon btn-iconOnly" id="auth-{{ componentName }}-menu-btn" type="button">
                <span class="icon">
                  {% include "partials/icons/menu.svg" %}
                </span>
              </button>
            </div>
          </div>
        </div>
        <div class="header-expanded">
          <div class="fs-nav-btnGroup">
            <div class="fs-btn-group">
              <button commandfor="auth-{{ componentName }}-overlay" command="show-modal" aria-label="Open the shoppers menu" id="auth-{{ componentName }}-menu-btn" type="button" class="fs-btn btn-tertiary btn-identityAvatar">
                <span class="icon">MJ</span>
                <span class="label">Monet</span>
                <span class="label-extra">Profile + settings</span>
              </button>
            </div>
          </div>
        </div>
      </div>

    </nav>
  </div>
</header>
{% include "partials/fs-components/fs-auth-dialog-profile_settings.njk" %}
