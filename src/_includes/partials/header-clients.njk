{% set pageName = "clients" %}
{% set componentName = "signin" %}
{% set logoDescription = "Fake Supermarket logo" %}

<header id="header-{{ pageName }}" class="fs-header">
  <div class="container">
    <nav id="site-navigation" class="fs-nav-main">

      <a title="{{ logoDescription }}" href="{{ site.root }}" id="site-logo">
        <svg class="fs-logo-symbol" viewBox="0 0 228 228" aria-hidden="true">
          <use href="#fs-logo"></use>
        </svg>        
      </a> 

      <div id="header-{{ pageName }}-auth" class="fs-nav-btnGroup">
        <div class="header-compact">
          <button commandfor="auth-{{ pageName }}-overlay" command="show-modal" aria-label="Open the site menu" class="fs-btn btn-tertiary btn-icon btn-iconOnly" id="auth-{{ pageName }}-menu-btn" type="button">
            <span class="icon">
              {% include "partials/icons/menu.svg" %}
            </span>
          </button>
        </div>

        <div class="header-expanded">
  {% if showAuthDialogue %} 
          <div class="fs-btn-group">
            <a class="fs-btn btn-tertiary" href="/clients/">
              <span class="label">Book a demo</span>
            </a>
            <button commandfor="auth-{{ componentName }}-overlay" command="show-modal" aria-label="Open the sign-in menu" class="fs-btn btn-tertiary" id="auth-{{ componentName }}-menu-btn" type="button">
              <span class="label">Sign in</span>
            </button>
            <a href="{{ site.root }}/participants/index.html" class="fs-btn btn-primary">
              <span class="label">Get paid to do fake shopping</span>
              <span class="icon">
                {% include "partials/icons/chevrons-right.njk" %}
              </span>
            </a>    
          </div> 
  {% else %}
          <div class="fs-btn-group">
            <a href="{{ site.root }}/participants/index.html" class="fs-btn btn-primary">
              <span class="label">Get paid to do fake shopping</span>
              <span class="icon">
                {% include "partials/icons/chevrons-right.njk" %}
              </span>              
            </a>
          </div>    
  {% endif %}        

          </div> 
        </div>
      </div> 

    </nav>
  </div>
</header>
{% include "partials/fs-components/fs-auth-dialog-siteroot.njk" %}
{% include "partials/fs-components/fs-auth-dialog-signin.njk" %}