<dialog id="auth-{{ pageName }}-overlay" aria-labelledby="auth-{{ pageName }}-title" class="fs-dialog-overlay fs-auth-overlay">
  <header id="auth-{{ pageName }}-dialog-header" class="fs-dialog__header">
    <h2 id="auth-{{ pageName }}-title" class="fs-dialog__heading">Fake Supermarket</h2>
    <button commandfor="auth-{{ pageName }}-overlay" command="close" aria-label="Close the site panel" class="fs-btn btn-tertiary btn-icon btn-iconOnly" id="auth-{{ pageName }}-btn-close" type="button">
      <span class="icon">
        <svg class="fs-logo-symbol" viewBox="0 0 24 24" aria-hidden="true"><use href="#fs-x"></use></svg>
      </span>
    </button>
  </header>

  <section id="auth-{{ pageName }}-dialog-body" class="fs-dialog__body" aria-label="Account sign-in options">
    <div id="auth-{{ pageName }}-dialog-signin" class="fs-dialog__group wrapper">
      <div class="fs-btn-group">
        {% if site.bookingUrl %}
        <a class="fs-btn btn-tertiary" href="{{ site.bookingUrl }}" autofocus>
          <span class="label">Book a demo</span>
        </a>
        {% else %}
        <button class="fs-btn btn-tertiary" type="button" autofocus>
          <span class="label">Book a demo</span>
        </button>
        {% endif %}
        <button commandfor="auth-{{ componentName }}-overlay" command="show-modal" aria-label="Open the sign-in menu" class="fs-btn btn-tertiary" type="button">
          <span class="label">Sign in</span>
        </button>
      </div>
    </div>
    <div id="auth-{{ pageName }}-dialog-participants" class="fs-dialog__group wrapper">
      <a href="{{ site.root }}/participants/index.html" class="fs-btn btn-primary">
        <span class="label">Get paid for fake shopping</span>
        <span class="icon">{% include "partials/icons/chevrons-right.njk" %}</span>
      </a>
    </div>
  </section>
</dialog>
