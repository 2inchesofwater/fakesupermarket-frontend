<section id="auth-signupEmail-dialog-body" class="fs-dialog-body fs-dialog__body" aria-label="Sign up with email">
  <form>
    {% set input = {
      slug: "signup-email",
      title: "Email",
      type: "email",
      passthroughAttributes: "required autocomplete='email' autofocus"
    } %}
    {% include "partials/fs-components/fs-inputGroup-core-text.njk" %}

    {% set input = {
      slug: "signup-password",
      title: "Password",
      help: "Use at least 8 characters. Longer passwords are stronger.",
      type: "password",
      passthroughAttributes: "required autocomplete='new-password' spellcheck='false' autocapitalize='none'",
      button: {
        id: "signup-password-reveal",
        label: "Show password",
        icon: {
          default: "#reveal-off",
          active: "#reveal-on"
        }
      }
    } %}
    {% include "partials/fs-components/fs-inputGroup-core-text.njk" %}

    <div class="fs-input-checkboxGroup fs-inputGroup">
      {% set input = {
        slug: "signup-legals",
        useModernCheckbox: true,
        title: "By proceeding, you agree to our <a href='" ~ site.root ~ "/pages/terms/index.html'>terms and conditions</a>.",
        help: ("For more information about how we use your data, including the generation of random identifiers based on your email address for research and analysis purposes, visit our <a href='" ~ site.root ~ "/pages/privacy/index.html'>privacy policy</a>.") | safe,
        checkboxSize: "lg",
        passthroughAttributes: "required"
      } %}
      {% include "partials/fs-components/fs-inputGroup-core-checkbox.njk" %}
    </div>

    <div id="inputGroup-signup-continue" class="fs-inputGroup fs-btn-group">
      <button class="fs-btn btn-primary btn-icon" type="submit">
        <span class="label">Continue</span>
      </button>
    </div>
  
  </form>

    <div id="auth-signupEmail-dialog-footer" class="fs-dialog__group">
      <p>Already have an account?</p>
      <button class="fs-btn btn-tertiary btn-sm" type="button" data-auth-target="signin"><span class="label">Sign in</span></button>
    </div>  
</section>
