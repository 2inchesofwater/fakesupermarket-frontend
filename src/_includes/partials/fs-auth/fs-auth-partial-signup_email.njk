<section id="auth-signupEmail-dialog-body" class="fs-dialog__body" aria-label="Sign up with email">
  <div class="fs-dialog__group">
    {% set signupForm = { inDialog: true } %}
    {% include "partials/fs-auth/fs-auth-form-signup_email.njk" %}
  </div>
  <div id="auth-signupEmail-dialog-secondary" class="fs-dialog__group">
    <p>Already have an account?</p>
    <button class="fs-btn btn-tertiary btn-sm" type="button" data-auth-target="signin">
      <span class="label">Sign in</span>
    </button>
  </div>
</section>
