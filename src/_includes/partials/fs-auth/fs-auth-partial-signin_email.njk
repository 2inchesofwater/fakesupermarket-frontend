{% set componentName = 'signinEmail' %}

<section id="auth-{{ componentName }}-dialog-body" class="fs-dialog__body" aria-label="Sign in with email">
  <div class="fs-dialog__group">
    <form data-auth-submit-target="signup-confirmation">
      {% set input = {
        slug: "signin",
        title: "Email",
        type: "email",
        passthroughAttributes: "required autocomplete='email' autofocus"
      } %}
      {% include "partials/fs-components/fs-inputGroup-core-text.njk" %}


      {% set input = {
        slug: "password",
        title: "Password",
        type: "password",
        passthroughAttributes: "required autocomplete='current-password' spellcheck='false' autocapitalize='none'",
        button: {
          id: "signin-password-reveal",
          label: "Show password",
          icon: {
            default: "#reveal-off",
            active: "#reveal-on"
          }
        }
      } %}
      {% include "partials/fs-components/fs-inputGroup-core-text.njk" %} 

      <div id="fs-inputGroup-continue" class="fs-inputGroup fs-btn-group">
        <button class="fs-btn btn-primary" type="submit">
          <span class="label">Continue</span>
        </button>
      </div>
    </form>    
  </div> 
  
  <div id="auth-{{ componentName }}-dialog-secondary" class="fs-dialog__group">
    <button class="fs-btn btn-tertiary btn-sm" type="button" data-auth-target="forgot-password">
      <span class="label">Forgot your password?</span>
    </button>
  </div>         
</section>

