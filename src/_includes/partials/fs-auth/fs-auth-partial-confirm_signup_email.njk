<section id="auth-confirmSignupEmail-dialog-body" class="fs-dialog__body" aria-label="Confirm your email" aria-busy="false" aria-live="polite" data-auth-view="signup-confirmation" data-auth-title="Confirm your email" hidden>
  <div id="auth-confirmSignupEmail-messageSent" class="fs-dialog__group">
    <p>We sent a code to <span class="text-highlight" data-auth-confirmation-email>home@2inchesofwater.com</span>.</p>
    <p id="auth-confirmSignupEmail-messageSent-help">The link will expire shortly. If you don’t see the email, check your spam folder.</p>
  </div>
  <div class="fs-dialog__group">
    <form data-auth-confirmation-form>
      <div id="inputGroup-auth-confirm-code" class="fs-inputGroup fs-inputGroup-text">
        <div class="fs-inputGroup-content">
          <label class="fs-label" for="fs-input-auth-confirm-code">Confirmation code</label>
        </div>
        <p id="input-auth-confirm-code-error" class="fs-input-warning" hidden>
          <span class="icon"></span>
          <span class="text-label">Enter a Confirmation code</span>
        </p>
        <div class="fs-inputControl">
          <input class="fs-input" id="fs-input-auth-confirm-code" name="confirmationCode" type="text" inputmode="numeric" autocomplete="one-time-code" value="724657" aria-describedby="auth-confirmSignupEmail-status" required autofocus>
        </div>
        <p id="auth-confirmSignupEmail-status" class="fs-inputGroup-help" aria-live="polite" role="status">We sent a confirmation code to your email address.</p>
      </div>
      <div id="inputGroup-confirmSignupEmail-continue" class="fs-inputGroup fs-btn-group">
        <button class="fs-btn btn-primary" type="submit">
          <span class="label">Continue</span>
        </button>
      </div>
    </form>
  </div>
  <div id="auth-confirmSignupEmail-dialog-secondary" class="fs-dialog__group">
    <p>Still can’t find it?</p>
    <button class="fs-btn btn-tertiary btn-sm" type="button">
      <span class="label">Resend the email</span>
    </button>
  </div>
</section>
