{# One email sign-up form for the dialog and standalone panel. Keep their existing field IDs. #}
{% set signupInDialog = signupForm.inDialog | default(false) %}
{% set emailSlug = "signup-email" if signupInDialog else "signup" %}
{% set passwordSlug = "signup-password" if signupInDialog else "password" %}
{% set legalsSlug = "signup-legals" if signupInDialog else "legals" %}

<form class="fs-auth-signup-form"{% if signupInDialog %} data-auth-submit-target="signup-confirmation"{% endif %}>
  {% set input = {
    slug: emailSlug,
    title: "Email",
    type: "email",
    passthroughAttributes: "required autocomplete='email' autofocus" if signupInDialog else "required autocomplete='email'"
  } %}
  {% include "partials/fs-components/fs-inputGroup-core-text.njk" %}

  {% set input = {
    slug: passwordSlug,
    title: "Password",
    help: "Use at least 8 characters. Longer passwords are stronger.",
    type: "password",
    passthroughAttributes: "required autocomplete='new-password' spellcheck='false' autocapitalize='none'",
    button: {
      id: "signup-password-reveal",
      label: "Show password",
      icon: {
        default: "#reveal-off",
        active: "#reveal-on"
      }
    } if signupInDialog else false
  } %}
  {% include "partials/fs-components/fs-inputGroup-core-text.njk" %}

  <div class="fs-input-checkboxGroup fs-inputGroup fs-auth-signup-form__legals">
    {% set input = {
      slug: legalsSlug,
      useModernCheckbox: true,
      title: "By proceeding, you agree to our <a href='" ~ site.root ~ "/pages/terms/index.html'>terms and conditions</a>.",
      help: ("For more information about how we use your data, including the generation of random identifiers based on your email address for research and analysis purposes, visit our <a href='" ~ site.root ~ "/pages/privacy/index.html'>privacy policy</a>.") | safe,
      checkboxSize: "lg",
      passthroughAttributes: "required"
    } %}
    {% include "partials/fs-components/fs-inputGroup-core-checkbox.njk" %}
  </div>

  <div id="{{ 'inputGroup-signup-continue' if signupInDialog else 'inputGroup-continue' }}" class="fs-inputGroup fs-btn-group">
    <button class="fs-btn btn-primary{% if not signupInDialog %} btn-lg{% endif %}" type="submit">
      <span class="label">Continue</span>
    </button>
  </div>
</form>
