{% set pageName = "staticpages" %}
{% set logoDescription = "Fake Supermarket" %}

<header id="header-{{ pageName }}" class="fs-header">
  <div class="container">
    <nav id="nav-main" >

      <a title="{{ logoDescription }}" href="{{ site.root }}" id="site-logo">
        <span class="icon">
          <svg class="fs-logo-symbol" viewBox="0 0 228 228" aria-hidden="true">
            <use href="#fs-logo"></use>
          </svg>
        </span>
      </a> 
      
    </nav>
  </div>
</header>