{% macro contentFeaturesList(items, size="md") %}
  <ul class="fs-content fs-content--featuresList fs-listBlock-{{ size }}" role="list">
    {% for item in items %}
      <li class="fs-content__inner">
        {% if item.title %}
          <div class="fs-content__header">
            {% if item.eyebrow %}
              <p class="fs-eyebrow">{{ item.eyebrow | safe }}</p>
            {% endif %}

            <h3 class="fs-content__heading">{{ item.title | safe }}</h3>
          </div>
        {% endif %}
        {% if item.body %}
          <div class="fs-content__group">
            {% for paragraph in item.body %}
              <p>{{ paragraph | safe }}</p>
            {% endfor %}
          </div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}