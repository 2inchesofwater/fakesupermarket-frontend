{% from "./fs-contentMediaItem.njk" import mediaItem %}

{% macro contentMediaColumn(data) %}

  <div class="fs-contentMedia fs-contentMedia--column">
    {% for item in data %}
      <figure class="fs-contentMedia__item">
        {{ mediaItem(item) }}

        {% if item.caption %}
          <figcaption class="fs-contentMedia__caption">{{ item.caption | safe }}</figcaption>
        {% endif %}
      </figure>
    {% endfor %}
  </div>

{% endmacro %}