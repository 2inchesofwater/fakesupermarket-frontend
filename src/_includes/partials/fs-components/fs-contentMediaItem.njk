{% macro mediaItem(media) %}
  
  {% set imageProperties = media.imageProperties | default({}) %}
  {% if media.type == "video" %}
    <video
      class="fs-contentMedia__asset"
      {% if media.width %}width="{{ media.width }}"{% endif %}
      {% if media.height %}height="{{ media.height }}"{% endif %}
      {% if media.poster %}poster="{{ media.poster }}"{% endif %}
      controls
    >
      <source src="{{ media.src }}">
    </video>

  {% else %}
    <img
      class="fs-contentMedia__asset"
      src="{{ media.src }}"
      {% if imageProperties.srcset %}
        srcset="{{ imageProperties.srcset }}"
      {% endif %}
      {% if imageProperties.sizes %}
        sizes="{{ imageProperties.sizes }}"
      {% endif %}
      alt="{{ media.alt | default('') }}"
      {% if media.width %}width="{{ media.width }}"{% endif %}
      {% if media.height %}height="{{ media.height }}"{% endif %}
      loading="{{ imageProperties.loading | default('lazy') }}"
      {% if imageProperties.fetchpriority %}
        fetchpriority="{{ imageProperties.fetchpriority }}"
      {% endif %}
    >
  {% endif %}

{% endmacro %}