{# 

  Accepts – 
  slug                    - string, unique, used for ID attributes.
  title                   - Required. String, used for the label. HTML-capable.
  help                    - string. Additional guidance for users, such as a helpful example of valid input.
  type                    - string. One of the input 'type' options, such as 'text', 'email', or 'password'.
  passthroughAttributes   - string, used to pass config. HTML-capable. Don't use double-apostrophes.

 #}

<div id="inputGroup-{{ input.slug }}" class="fs-inputGroup fs-inputGroup-text">
  {% if input.title or input.help %}
    <div class="fs-inputGroup-content">
      {% if input.title %}
        <label class="fs-label" for="fs-input-{{ input.slug }}">
          {{ input.title }}
        </label>
      {% endif %}

      {% if input.help %}
        <div class="fs-inputGroup-help">
          {{ input.help }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <p hidden id="input-{{ input.slug }}-error" class="fs-input-warning">
    <span class="icon"></span>
    <span class="text-label">Enter a {{ input.title }}</span>
  </p>

  <div class="fs-inputControl{% if input.button %} fs-inputControl-segmented{% endif %}">
  <input
    class="fs-input"
    id="fs-input-{{ input.slug }}"
    name="fs-input-{{ input.slug }}"
    type="{{ input.type }}"
    {% if input.passthroughAttributes %}
      {{ input.passthroughAttributes | safe }}
    {% endif %}
  >

  {% if input.button %}
    <button
      type="button"
      id="{{ input.button.id }}"
      class="fs-btn fs-inputControl-action{% if input.button.icon %} btn-icon btn-tertiary btn-iconOnly{% endif %}"
      aria-label="{{ input.button.label }}"
      aria-controls="fs-input-{{ input.slug }}"
      data-state="default"
    >
      {% if input.button.icon %}
        <svg
          viewBox="{{ input.button.icon.viewBox | default('0 0 24 24') }}"
          aria-hidden="true"
          focusable="false"
        >
          <use
            class="svg-default"
            href="{{ input.button.icon.default }}"
          ></use>

          {% if input.button.icon.active %}
            <use
              class="svg-active"
              href="{{ input.button.icon.active }}"
            ></use>
          {% endif %}
        </svg>
      {% else %}
        <span class="label">{{ input.button.label }}</span>
      {% endif %}
    </button>
  {% endif %}
</div>

  {% if input.type == "password" and input.button %}
    <script>
      (() => {
        const group = document.currentScript.closest('.fs-inputGroup');
        const field = group.querySelector('.fs-input');
        const button = group.querySelector('.fs-inputControl-action');
        const visibleLabel = button.querySelector('.label');
        const hiddenLabel = button.getAttribute('aria-label');

        button.addEventListener('click', () => {
          const reveal = field.type === 'password';
          const label = reveal ? 'Hide password' : hiddenLabel;

          field.type = reveal ? 'text' : 'password';
          button.dataset.state = reveal ? 'active' : 'default';
          button.setAttribute('aria-label', label);

          if (visibleLabel) visibleLabel.textContent = label;
        });
      })();
    </script>
  {% endif %}
</div>
