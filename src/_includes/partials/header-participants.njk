{% set pageName = "participants" %}
{% set componentName = "signup" %}
{% set logoDescription = "Fake Supermarket logo" %}

<header id="header-{{ pageName }}" class="fs-header">
  <div class="container">
    <nav id="site-navigation" class="fs-nav-main">

      <a title="{{ logoDescription }}" href="{{ site.root }}" id="site-logo">
        <svg class="fs-logo-symbol" viewBox="0 0 228 228" aria-hidden="true">
          <use href="#fs-logo"></use>
        </svg>        
      </a> 

      <div id="header-{{ pageName }}-auth" class="fs-nav-btnGroup">
        <div class="header-compact">
          <button commandfor="auth-signup-overlay" command="show-modal" aria-label="Open the site menu" class="btn btn-tertiary btn-icon btn-iconOnly" id="auth-siteroot-menu-btn" type="button">
            <span class="icon">
              {% include "partials/icons/menu.svg" %}
            </span>
          </button>
        </div>      
        <div class="header-expanded">
  {% if showAuthDialogue %}         
          <button commandfor="auth-{{ componentName }}-overlay" command="show-modal" aria-label="Open the site menu" class="fs-btn btn-primary" id="auth-{{ componentName }}-menu-btn" type="button">
            <span class="label">Sign up today</span>
          </button>
  {% else %}
          <div class="fs-btn-group">
            <div class="fs-btn btn-primary btn-placeholder">Coming soon</div>
          </div>
  {% endif %}          
        </div>
      </div>

    </nav>
  </div>
</header>

{% include "partials/fs-components/fs-auth-dialog-signup.njk" %}