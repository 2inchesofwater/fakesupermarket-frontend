<footer id="customerservice" class="storefront-customerservice">
  <div class="customerservice__inner">

      <div disabled id="followUs" class="fs-unavailable customerservice__group">
        <div class="customerservice__header">
          <h3 class="customerservice__heading">Follow us</h3>
        </div>
        <ul class="customerservice__body">
          <li class="customerservice__roundel">
            <span class="icon">
              {% include "partials/icons/instagram.svg" %}
            </span>
          </li>
          <li class="customerservice__roundel">
            <span class="icon">
              {% include "partials/icons/facebook.svg" %}
            </span>
          </li>
          <li class="customerservice__roundel">
            <span class="icon">
              {% include "partials/icons/youtube.svg" %}
            </span>
          </li>
          <li class="customerservice__roundel">
            <span class="icon">
              {% include "partials/icons/tiktok.svg" %}
            </span>
          </li>          
        </ul>
      </div>

      <div disabled id="customerService" class="fs-unavailable customerservice__group">
        <div class="customerservice__header">
          <h3 class="customerservice__heading">Customer help</h3>
        </div>
        <ul class="customerservice__list">
          <li class="customerservice__item"><span>Help & FAQs</span></li>
          <li class="customerservice__item"><span>Contact us</span></li>
          <li class="customerservice__item"><span>Feedback</span></li>
          <li class="customerservice__item"><span>Product recalls</span></li>
          <li class="customerservice__item"><span>Returns & refunds</span></li>
          <li class="customerservice__item"><span>Scam alerts</span></li>
          <li class="customerservice__item"><span>Accessibility information</span></li>
        </ul>
      </div>
      
      <div disabled id="shopping" class="fs-unavailable customerservice__group">
        <div class="customerservice__header">
          <h3 class="customerservice__heading">Shopping</h3>
        </div>
        <ul class="customerservice__list">
          <li class="customerservice__item"><span>Track my order</span></li>
          <li class="customerservice__item"><span>Delivery options</span></li>
          <li class="customerservice__item"><span>Click & Collect</span></li>
          <li class="customerservice__item"><span>Delivery Saver Pass</span></li>
          <li class="customerservice__item"><span>Fake Supermarket app</span></li>
          <li class="customerservice__item"><span>New to online shopping?</span></li>
          <li class="customerservice__item"><span>Shop for your business</span></li>
          <li class="customerservice__item"><span>Fake Flowers</span></li>
        </ul>
      </div>
      
      <div disabled id="contact" class="fs-unavailable customerservice__group">
        <div class="customerservice__header">
          <h3 class="customerservice__heading">Contact</h3>
        </div>
        <ul class="customerservice__list">
          <li class="customerservice__item"><span>Careers</span></li>
          <li class="customerservice__item"><span>Why choose us?</span></li>
          <li class="customerservice__item"><span>Our brands</span></li>
          <li class="customerservice__item"><span>Community donations</span></li>
          <li class="customerservice__item"><span>Vendor information</span></li>
          <li class="customerservice__item"><span>Become an affiliate</span></li>
          <li class="customerservice__item"><span>Corporate responsibility</span></li>
        </ul>
      </div>
    </div>
  </div>


</footer>